generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  password      String
  role          String   @default("user")
  phone         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  registrations Registration[]
  merchOrders   MerchOrder[]
}

model Event {
  id          String   @id @default(cuid())
  title       String
  date        String
  time        String
  timeEnd     String   @default("")
  location    String
  priceRange  String
  image       String   @default("/hero-banner.png")
  distances   String
  description String
  status      String   @default("upcoming")
  featured    Boolean  @default(false)
  regCloseDate String @default("")
  regCloseTime String @default("")
  basePrice      Int    @default(0)
  finisherShirtPrice Int @default(0)
  singletPrice    Int    @default(0)
  finisherShirtSizes String?
  singletSizes       String?
  distancePricing     String  @default("")  // JSON: {"3K": 250, "5K": 350, "10K": 500}
  distanceInclusions  String  @default("")  // JSON: {"3K": ["Race Bib","Finishers Medal"], "5K": ["Race Bib","Post-Race Meal"]}
  isPackage           Boolean @default(false) // true = complete package (add-ons included)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  results     RaceResult[]
  registrations Registration[]
  onsiteRegistrations OnSiteRegistration[]
}

model MerchItem {
  id          String   @id @default(cuid())
  name        String
  price       Int
  image       String   @default("/merch-banner.png")
  category    String
  description String
  sizes       String?
  badge       String?
  stock       Int      @default(0)
  soldCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RaceResult {
  id        String   @id @default(cuid())
  eventId   String
  distance  String
  finishers String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Registration {
  id              String   @id @default(cuid())
  userId          String
  eventId         String
  distance        String
  finisherShirtSize String?
  singletSize       String?
  totalAmount      Int    @default(0)
  paymentStatus   String  @default("pending")  // "pending", "paid", "failed", "refunded"
  paymentMethod   String?   // "gcash", "maya", "grabpay", "cash"
  paymentReference String?  // PayMongo source ID or reference
  referenceNumber String?  // Custom reference: MMDDYYYYHHMMRRR
  paidAt          DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model POSOrder {
  id            String         @id @default(cuid())
  orderNumber   String         @unique
  totalAmount   Int
  paymentMethod String         @default("cash")
  customerName  String         @default("Walk-in Customer")
  staffName     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  items         POSOrderItem[]
}

model POSOrderItem {
  id        String   @id @default(cuid())
  orderId   String
  itemId    String
  itemName  String
  price     Int
  quantity  Int
  size      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     POSOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model SystemLog {
  id          String   @id @default(cuid())
  action      String   // e.g., "CREATE_EVENT", "UPDATE_EVENT", "DELETE_EVENT", "CREATE_MERCH", "UPDATE_MERCH", "DELETE_MERCH", "POS_SALE", "ONSITE_REG", "UPDATE_SETTINGS", "USER_LOGIN", etc.
  category    String   // e.g., "events", "inventory", "pos", "registrations", "users", "settings", "auth", "results"
  description String   // Human-readable description
  userId      String?  // Who performed the action
  userName    String?  // Name of the user who performed the action
  userRole    String?  // Role of the user
  details     String?  // JSON string with additional details
  createdAt   DateTime @default(now())
}

model OnSiteRegistration {
  id            String   @id @default(cuid())
  eventId       String
  participantName  String
  participantEmail String?
  participantPhone String?
  distance      String
  paymentMethod String   @default("cash")
  amountPaid    Int      @default(0)
  finisherShirtSize String?
  singletSize       String?
  staffName     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model MerchOrder {
  id              String   @id @default(cuid())
  userId          String
  orderNumber     String   @unique
  totalAmount     Int
  paymentStatus   String   @default("pending")  // "pending", "paid", "failed", "refunded"
  paymentMethod   String?    // "gcash", "maya", "grabpay"
  paymentReference String?  // PayMongo source ID
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           MerchOrderItem[]
}

model MerchOrderItem {
  id        String   @id @default(cuid())
  orderId   String
  itemId    String
  itemName  String
  price     Int
  quantity  Int
  size      String?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     MerchOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
