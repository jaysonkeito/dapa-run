generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  password      String
  role          String   @default("user")
  phone         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  registrations Registration[]
}

model Event {
  id          String   @id @default(cuid())
  title       String
  date        String
  time        String
  location    String
  priceRange  String
  image       String   @default("/hero-banner.png")
  distances   String
  description String
  status      String   @default("upcoming")
  featured    Boolean  @default(false)
  regCloseDate String @default("")
  regCloseTime String @default("")
  basePrice      Int    @default(0)
  finisherShirtPrice Int @default(0)
  singletPrice    Int    @default(0)
  finisherShirtSizes String?
  singletSizes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  results     RaceResult[]
  registrations Registration[]
  onsiteRegistrations OnSiteRegistration[]
}

model MerchItem {
  id          String   @id @default(cuid())
  name        String
  price       Int
  image       String   @default("/merch-banner.png")
  category    String
  description String
  sizes       String?
  badge       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RaceResult {
  id        String   @id @default(cuid())
  eventId   String
  distance  String
  finishers String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Registration {
  id              String   @id @default(cuid())
  userId          String
  eventId         String
  distance        String
  finisherShirtSize String?
  singletSize       String?
  totalAmount      Int    @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model POSOrder {
  id            String         @id @default(cuid())
  orderNumber   String         @unique
  totalAmount   Int
  paymentMethod String         @default("cash")
  customerName  String         @default("Walk-in Customer")
  staffName     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  items         POSOrderItem[]
}

model POSOrderItem {
  id        String   @id @default(cuid())
  orderId   String
  itemId    String
  itemName  String
  price     Int
  quantity  Int
  size      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     POSOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OnSiteRegistration {
  id            String   @id @default(cuid())
  eventId       String
  participantName  String
  participantEmail String?
  participantPhone String?
  distance      String
  paymentMethod String   @default("cash")
  amountPaid    Int      @default(0)
  finisherShirtSize String?
  singletSize       String?
  staffName     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}
